{
  "buildCommand": "node --max-old-space-size=4096 node_modules/.bin/vite build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://athletic-connection-production-7781.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://athletic-connection-production-7781.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
